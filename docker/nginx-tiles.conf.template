# Caching reverse proxy in front of the Esri World Imagery tile service.
# Sized for one LAN, one user, occasional map views — not a production tile
# service. Eviction is nginx's built-in cache manager (LRU-style once
# max_size is hit); no custom eviction logic needed.
#
# nginx's stock docker-entrypoint envsubst's ${VAR} references in any
# /etc/nginx/templates/*.template file into /etc/nginx/conf.d/ on container
# start, so TILE_CACHE_TTL / TILE_CACHE_MAX_SIZE_MB come from real
# environment variables with no custom entrypoint needed.
proxy_cache_path /var/cache/nginx/tiles levels=1:2 keys_zone=tiles:10m
    max_size=${TILE_CACHE_MAX_SIZE_MB}m inactive=7d use_temp_path=off;

# One shared client (the web container) fronts every browser, so the limit is
# loose enough for a map view loading a few dozen tiles at once.
limit_req_zone $binary_remote_addr zone=tilereq:1m rate=100r/s;

server {
    listen 8080;
    server_tokens off;

    location = /healthz {
        default_type application/json;
        return 200 '{"status":"ok"}';
    }

    # Only /{z}/{y}/{x} is proxied; anything else is a 404. The rewrite builds
    # Esri's real path (proxy_pass can't carry a URI inside a regex location)
    # and its trailing "?" drops the query string so it can't vary the cache.
    location ~ ^/\d+/\d+/\d+$ {
        limit_except GET HEAD { deny all; }
        limit_req zone=tilereq burst=200 nodelay;
        limit_req_status 429;
        rewrite ^/(.*)$ /ArcGIS/rest/services/World_Imagery/MapServer/tile/$1? break;
        proxy_pass https://server.arcgisonline.com;
        proxy_cache tiles;
        proxy_cache_key $uri;
        proxy_cache_lock on;
        proxy_cache_valid 200 ${TILE_CACHE_TTL}s;
        proxy_cache_use_stale error timeout updating http_502 http_503 http_504;
        proxy_set_header Host server.arcgisonline.com;
        proxy_ssl_server_name on;
        add_header X-Cache-Status $upstream_cache_status always;
        add_header X-Tile-Attribution "Imagery (c) Esri, Maxar, Earthstar Geographics" always;
        add_header X-Content-Type-Options "nosniff" always;
    }

    location / {
        return 404;
    }
}
